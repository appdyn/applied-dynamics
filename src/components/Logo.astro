---
const { dark = false } = Astro.props;
---
<a href="/" class:list={['logo',{dark}]} aria-label="Applied Dynamics home"><span class="word">APPLI<span class="e"><i></i><i></i><i></i></span>D</span><span class="dyn">D Y N A M I C S</span></a>
<style>
.logo{display:inline-flex;flex-direction:column;text-decoration:none;line-height:1;color:#07182d}.logo.dark{color:#fff}.word{display:flex;align-items:center;font-size:27px;font-weight:800}.dyn{margin-top:5px;font-size:11px;font-weight:600;letter-spacing:.44em}.e{display:inline-flex;flex-direction:column;justify-content:space-between;width:19px;height:23px;margin-inline:1px}.e i{height:4px;background:#1687ff}.e i:nth-child(2){width:14px}
</style>
