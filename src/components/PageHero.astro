---
const {
  eyebrow = '',
  title,
  description,
  image = '',
  variant = 'network'
} = Astro.props;
---

<section class={`page-hero hero-${variant}`}>
  {image && (
    <img
      class="hero-image"
      src={image}
      alt=""
      aria-hidden="true"
      loading="eager"
    />
  )}

  <div class="hero-shade" aria-hidden="true"></div>

  {!image && (
    <div class="visual" aria-hidden="true">
      <span class="orbit o1"></span>
      <span class="orbit o2"></span>
      <span class="orbit o3"></span>
      <span class="node n1"></span>
      <span class="node n2"></span>
      <span class="node n3"></span>
      <span class="node n4"></span>
      <span class="node n5"></span>
      <span class="node n6"></span>
    </div>
  )}

  <div class="container page-hero-content">
    {eyebrow && <div class="page-eyebrow">{eyebrow}</div>}
    <h1>{title}</h1>
    <p>{description}</p>
  </div>
</section>

<style>
  .page-hero {
    min-height: 330px;
    position: relative;
    display: flex;
    align-items: center;
    overflow: hidden;
    color: #fff;
    background: linear-gradient(115deg, #061522 0%, #0b263f 58%, #0b3153 100%);
  }

  .hero-image {
    position: absolute;
    inset: 0 0 0 auto;
    width: 72%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: saturate(1.04) brightness(.76);
  }

  .hero-shade {
    position: absolute;
    z-index: 1;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        #061522 0%,
        rgba(6, 21, 34, .98) 34%,
        rgba(6, 21, 34, .86) 52%,
        rgba(6, 21, 34, .38) 72%,
        rgba(6, 21, 34, .12) 100%
      );
  }

  .page-hero-content {
    position: relative;
    z-index: 3;
    padding-block: 58px;
  }

  .page-eyebrow {
    margin-bottom: 15px;
    color: #64b2ff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .22em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 760px;
    margin: 0;
    font-size: clamp(2.65rem, 4.7vw, 4.2rem);
    line-height: 1.01;
    letter-spacing: -.05em;
  }

  p {
    max-width: 660px;
    margin: 20px 0 0;
    color: #c9d5e0;
    font-size: 16px;
    line-height: 1.7;
  }

  .visual {
    position: absolute;
    z-index: 0;
    right: 4%;
    top: 50%;
    width: 42%;
    height: 110%;
    transform: translateY(-50%);
    opacity: .70;
  }

  .orbit {
    position: absolute;
    border: 1px solid rgba(61, 163, 255, .28);
    border-radius: 50%;
    transform: rotate(-18deg);
  }

  .o1 { width: 540px; height: 190px; right: -80px; top: 20%; }
  .o2 { width: 450px; height: 155px; right: 20px; top: 37%; }
  .o3 { width: 360px; height: 125px; right: 90px; top: 53%; }

  .node {
    position: absolute;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #55b5ff;
    box-shadow: 0 0 18px #1687ff;
  }

  .n1 { right: 14%; top: 24%; }
  .n2 { right: 44%; top: 34%; }
  .n3 { right: 67%; top: 47%; }
  .n4 { right: 25%; top: 59%; }
  .n5 { right: 54%; top: 69%; }
  .n6 { right: 76%; top: 28%; }

  @media (max-width: 760px) {
    .hero-image {
      width: 100%;
      opacity: .48;
    }

    .hero-shade {
      background: rgba(4, 17, 31, .78);
    }

    .visual {
      right: -35%;
      width: 90%;
      opacity: .35;
    }
  }
</style>
