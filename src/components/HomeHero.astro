---
const desktopAsset = "/images/home-hero-approved.webp";
---

<section class="approved-hero" aria-labelledby="home-hero-heading">
  <div class="sr-only">
    <p>Secure · Automate · Accelerate</p>

    <h1 id="home-hero-heading">
      Practical AI and cybersecurity solutions for real-world teams.
    </h1>

    <p>
      Applied Dynamics helps organizations implement secure, scalable AI and
      technology solutions — from cybersecurity and cloud engineering to AI
      and agentic workflows — with a focus on mission-critical organizations
      and growing businesses.
    </p>

    <ul>
      <li>AI & Agentic Workflows</li>
      <li>Cloud Engineering</li>
      <li>Cybersecurity</li>
      <li>Secure Implementation</li>
      <li>U.S. Military & Defense</li>
      <li>Federal Government</li>
      <li>State & Local Government</li>
      <li>Commercial & Growing Businesses</li>
    </ul>
  </div>

  <div class="hero-artboard">
    <img
      src={desktopAsset}
      alt=""
      width="1536"
      height="924"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />

    <!-- Invisible, accessible click targets over the buttons already drawn in the artwork -->
    <a
      class="hero-hotspot hotspot-primary"
      href="/capabilities"
      aria-label="Explore Our Capabilities"
    ></a>

    <a
      class="hero-hotspot hotspot-secondary"
      href="/contact"
      aria-label="Talk With Our Team"
    ></a>
  </div>
</section>

<style>
  .approved-hero {
    width: 100%;
    overflow: hidden;
    background: #eef5fb;
  }

  .hero-artboard {
    position: relative;
    width: 100%;
    max-width: 1536px;
    margin-inline: auto;
  }

  .hero-artboard img {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero-hotspot {
    position: absolute;
    display: block;
    z-index: 3;
    border-radius: 8px;
    text-decoration: none;
  }

  .hero-hotspot:focus-visible {
    outline: 3px solid #0878f9;
    outline-offset: 3px;
  }

  /*
   * Coordinates are percentages of the approved hero artboard.
   * These overlay the two CTA buttons already visible in the image.
   */
  .hotspot-primary {
    left: 4.80%;
    top: 59.20%;
    width: 21.30%;
    height: 7.35%;
  }

  .hotspot-secondary {
    left: 27.45%;
    top: 59.20%;
    width: 18.40%;
    height: 7.35%;
  }

  .sr-only {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  @media (max-width: 900px) {
    .approved-hero {
      overflow-x: auto;
    }

    .hero-artboard {
      width: 1180px;
      max-width: none;
    }
  }
</style>
