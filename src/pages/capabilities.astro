---
import AppliedLayout from "../layouts/AppliedLayout.astro";
import ApprovedHero from "../components/ApprovedHero.astro";
import ServiceCard from "../components/ServiceCard.astro";
---
<AppliedLayout title="/capabilities" page="capabilities"><ApprovedHero page="capabilities" title="Our Capabilities" description="Secure, scalable technology solutions that solve real problems." width={336} height={135}/><section class="content capabilities"><ServiceCard title="Cybersecurity" text="Security engineering, risk management, incident response, and compliance solutions to protect what matters." icon="shield" image="cybersecurity" /><ServiceCard title="Artificial Intelligence" text="Practical AI and agentic workflows designed to automate work, unlock insights, and drive efficiency." icon="brain" image="artificial-intelligence" /><ServiceCard title="Cloud Engineering" text="Secure cloud architecture, modernization, and DevSecOps to build resilient and scalable environments." icon="cloud" image="cloud-engineering" /></section></AppliedLayout>
