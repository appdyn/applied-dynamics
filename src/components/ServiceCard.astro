---
const { title, text, icon, image, href, showLearn = true } = Astro.props;
---

<article class:list={["card", { "image-card": image }]}>
  <div class="card-body">
    {icon && <img class="icon" src={`/images/icon-${icon}.svg`} alt="" />}

    <div>
      <h2>{title}</h2>
      <p>{text}</p>

      {
        showLearn &&
          (href ? (
            <a class="learn" href={href}>
              Learn More <span aria-hidden="true">→</span>
            </a>
          ) : (
            <button class="learn unavailable" type="button" disabled>
              Learn More <span aria-hidden="true">→</span>
            </button>
          ))
      }
    </div>
  </div>

  {
    image && (
      <div class="card-image-wrap">
        <img
          class="card-image"
          src={`/images/${image}-sharp.webp`}
          alt=""
          loading="lazy"
        />
      </div>
    )
  }
</article>

<style>
  .card-image-wrap {
    width: 100%;
    aspect-ratio: 16 / 7;
    overflow: hidden;
    background: #eef3f8;
  }

  .card-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
</style>
