---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';

const insights = [
  {
    type: 'Use Case',
    title: 'Automating Document Processing with AI',
    excerpt: 'How secure AI workflows can classify, extract, analyze, and route business documents.',
    date: 'September 18, 2026'
  },
  {
    type: 'Benchmark',
    title: 'Local LLM Performance Benchmark',
    excerpt: 'Comparing inference performance and deployment tradeoffs across modern AI infrastructure.',
    date: 'September 12, 2026'
  },
  {
    type: 'Research',
    title: 'Securing Agentic AI Workflows',
    excerpt: 'Architecture patterns for identity, access control, tool execution, and agent governance.',
    date: 'September 5, 2026'
  },
  {
    type: 'Guide',
    title: 'AI Readiness Checklist for Growing Businesses',
    excerpt: 'A practical framework for evaluating whether your organization is ready for AI implementation.',
    date: 'August 28, 2026'
  },
  {
    type: 'Field Note',
    title: 'Lessons from Deploying RAG in a Controlled Environment',
    excerpt: 'Real-world lessons from architecture, retrieval quality, security, and deployment decisions.',
    date: 'August 20, 2026'
  },
  {
    type: 'Use Case',
    title: 'Internal Knowledge Assistant for Operations',
    excerpt: 'How an AI assistant can improve information discovery and workforce productivity.',
    date: 'August 15, 2026'
  }
];
---

<Layout title="Insights | Applied Dynamics">
  <PageHero
    eyebrow="Engineering Knowledge"
    title="Insights"
    description="Practical research, benchmarks, use cases, guides, and lessons from our engineering work."
    image="/images/insights-hero.png"
  />

  <section class="section">
    <div class="container">
      <div class="filters">
        <button class="active" data-filter="All">All</button>
        <button data-filter="Research">Research</button>
        <button data-filter="Benchmarks">Benchmarks</button>
        <button data-filter="Use Cases">Use Cases</button>
        <button data-filter="Guides">Guides</button>
        <button data-filter="Field Notes">Field Notes</button>
      </div>

      <div class="insight-grid">
        {insights.map(item => (
          <article class="insight-card card" data-type={item.type}>
            <div class="insight-placeholder" aria-hidden="true">
              <span>INSIGHT</span>
            </div>

            <div class="insight-content">
              <span class="content-type">{item.type}</span>
              <h2>{item.title}</h2>
              <p>{item.excerpt}</p>

              <footer>
                <span>{item.date}</span>
                <a href="#" aria-label={`Read ${item.title}`}>→</a>
              </footer>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filters button');
  const cards = document.querySelectorAll<HTMLElement>('.insight-card');

  const map: Record<string, string> = {
    Research: 'Research',
    Benchmarks: 'Benchmark',
    'Use Cases': 'Use Case',
    Guides: 'Guide',
    'Field Notes': 'Field Note'
  };

  buttons.forEach(button => {
    button.addEventListener('click', () => {
      buttons.forEach(item => item.classList.remove('active'));
      button.classList.add('active');

      const filter = button.dataset.filter || 'All';

      cards.forEach(card => {
        const show = filter === 'All' || card.dataset.type === map[filter];
        card.style.display = show ? '' : 'none';
      });
    });
  });
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 40px;
  }

  .filters button {
    border: 0;
    background: transparent;
    padding: 10px 18px;
    border-radius: 6px;
    cursor: pointer;
    color: #52677d;
  }

  .filters button.active {
    background: #0878f9;
    color: white;
  }

  .insight-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .insight-placeholder {
    height: 150px;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    padding: 16px;
    background:
      radial-gradient(circle at 80% 35%, rgba(22,135,255,.42), transparent 30%),
      linear-gradient(135deg, #06182b, #0b3153);
  }

  .insight-placeholder::after {
    content: '';
    position: absolute;
    width: 230px;
    height: 75px;
    right: -28px;
    top: 28px;
    border: 1px solid rgba(73,174,255,.42);
    border-radius: 50%;
    transform: rotate(-12deg);
  }

  .insight-placeholder span {
    position: relative;
    z-index: 2;
    color: rgba(255,255,255,.78);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .16em;
  }

  .insight-content { padding: 24px; }

  .content-type {
    color: #0878f9;
    text-transform: uppercase;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .12em;
  }

  h2 {
    margin: 12px 0;
    font-size: 18px;
    line-height: 1.3;
  }

  p {
    color: #5b6d80;
    font-size: 14px;
    line-height: 1.6;
  }

  footer {
    margin-top: 25px;
    display: flex;
    justify-content: space-between;
    color: #8494a6;
    font-size: 11px;
  }

  footer a {
    color: #0878f9;
    font-size: 20px;
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .insight-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 600px) {
    .insight-grid { grid-template-columns: 1fr; }
  }
</style>
