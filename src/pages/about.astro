---
import Layout from '../layouts/Layout.astro';import PageHero from '../components/PageHero.astro';import Icon from '../components/Icon.astro';
const values=[['shield','Integrity','We do what is right.'],['gear','Excellence','We deliver quality work and measurable results.'],['users','Practicality','We focus on real-world solutions that work.']];
---
<Layout title="About | Applied Dynamics"><PageHero eyebrow="About Applied Dynamics" title="Practical People. Real-World Impact." description="Applied Dynamics is a technology consultancy focused on helping organizations securely adopt AI, strengthen cybersecurity, and modernize their infrastructure." image="/images/hero-about.jpg"/><section class="section"><div class="container"><div class="section-label">Our Mission</div><h2 class="section-title">Technology that solves real problems.</h2><p class="section-description">We deliver practical, secure, and scalable technology solutions that help organizations achieve their goals and make a meaningful impact.</p><div class="values">{values.map(([icon,title,text])=><article><Icon name={icon}/><h3>{title}</h3><p>{text}</p></article>)}</div><div class="story"><div class="section-label">Our Story</div><h2>Experience built in demanding environments.</h2><p>Applied Dynamics was built by engineers and security professionals with deep experience supporting cybersecurity, architecture, incident response, information assurance, cloud engineering, and technology modernization.</p><p>Today, we're bringing that foundation into artificial intelligence, automation, machine learning, and agentic technologies for government and commercial organizations.</p></div></div></section></Layout>
<style>.values{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:55px}.values article{padding:32px;border:1px solid #e4eaf0;text-align:center;color:#0878f9}.values h3{color:#07182d}.values p{color:#5d7084}.story{max-width:800px;margin-top:90px}.story h2{font-size:35px}.story p{color:#566a80;line-height:1.8}@media(max-width:700px){.values{grid-template-columns:1fr}}</style>
