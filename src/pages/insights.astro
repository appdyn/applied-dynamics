---
import Layout from '../layouts/Layout.astro';import PageHero from '../components/PageHero.astro';
const insights=[['Use Case','Automating Document Processing with AI','How secure AI workflows can classify, extract, analyze, and route business documents.'],['Benchmark','Local LLM Performance Benchmark','Comparing inference performance and deployment tradeoffs across modern AI infrastructure.'],['Research','Securing Agentic AI Workflows','Architecture patterns for identity, access control, tool execution, and agent governance.'],['Guide','AI Readiness Checklist for Growing Businesses','A practical framework for evaluating whether your organization is ready for AI implementation.'],['Field Note','Lessons from Deploying RAG in a Controlled Environment','Real-world lessons from architecture, retrieval quality, security, and deployment decisions.'],['Use Case','Internal Knowledge Assistant for Operations','How an AI assistant can improve information discovery and workforce productivity.']];
---
<Layout title="Insights | Applied Dynamics"><PageHero eyebrow="Engineering Knowledge" title="Insights" description="Practical research, benchmarks, use cases, guides, and lessons from our engineering work." image="/images/hero-insights.jpg"/><section class="section"><div class="container"><div class="filters"><button class="active">All</button><button>Research</button><button>Benchmarks</button><button>Use Cases</button><button>Guides</button><button>Field Notes</button></div><div class="grid">{insights.map(([type,title,text])=><article class="card insight"><div class="image"></div><div class="content"><span>{type}</span><h2>{title}</h2><p>{text}</p><a href="#">Read More →</a></div></article>)}</div></div></section></Layout>
<style>.filters{display:flex;flex-wrap:wrap;gap:12px;margin-bottom:40px}.filters button{border:0;background:transparent;padding:10px 18px;border-radius:5px;color:#52677d}.filters .active{background:#0878f9;color:white}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}.image{height:150px;background:radial-gradient(circle at 70% 40%,#1687ff,transparent 40%),linear-gradient(130deg,#06182b,#16466e)}.content{padding:24px}.content span{color:#0878f9;text-transform:uppercase;font-size:10px;font-weight:700;letter-spacing:.12em}.content h2{font-size:18px;line-height:1.3}.content p{color:#5b6d80;font-size:14px;line-height:1.6}.content a{color:#0878f9;text-decoration:none;font-weight:600;font-size:13px}@media(max-width:900px){.grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:600px){.grid{grid-template-columns:1fr}}</style>
