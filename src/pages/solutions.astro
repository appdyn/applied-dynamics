---
import Layout from '../layouts/Layout.astro';import PageHero from '../components/PageHero.astro';import Icon from '../components/Icon.astro';
const items=[['brain','AI Deployment & Implementation','Assess, design, implement, and operationalize practical AI solutions tailored to your organization.'],['gear','Agentic Workflows','Build intelligent agents and workflows that automate complex processes and repetitive work.'],['chart','Business Process Automation','Reduce manual work, improve consistency, and give teams more time for higher-value activities.'],['brain','AI Knowledge & RAG','Turn organizational data into secure, searchable, AI-powered knowledge systems.'],['shield','Secure AI','Apply cybersecurity principles, access controls, governance, and monitoring to AI deployments.'],['gear','Ongoing Support & Optimization','Continuously improve, maintain, and scale technology solutions as your needs evolve.']];
---
<Layout title="Solutions | Applied Dynamics"><PageHero eyebrow="From Idea to Impact" title="Solutions for Real-World Impact" description="From strategy and implementation to ongoing support, we design and deploy secure AI, cybersecurity, and cloud solutions that deliver measurable value." image="/images/hero-solutions.jpg"/><section class="section"><div class="container grid-2">{items.map(([icon,title,text])=><article class="card solution"><Icon name={icon}/><h2>{title}</h2><p>{text}</p><a href="/contact">Learn More →</a></article>)}</div></section></Layout>
<style>.solution{min-height:250px;padding:34px;color:#0878f9}.solution h2{margin:24px 0 10px;color:#07182d;font-size:20px}.solution p{color:#5c6e82;line-height:1.65}.solution a{display:inline-block;margin-top:10px;color:#0878f9;text-decoration:none;font-weight:600;font-size:14px}</style>
