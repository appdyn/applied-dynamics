---
import "../styles/applied-dynamics.css";
import CompanyLogo from "../components/CompanyLogo.astro";
const { title, page } = Astro.props;
const links = [
  ["Home", "/"],
  ["Capabilities", "/capabilities"],
  ["Solutions", "/solutions"],
  ["Industries", "/industries"],
  ["Insights", "/insights"],
  ["About", "/about"],
  ["Careers", "/careers"],
  ["Contact", "/contact"],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <title>{title} | Applied Dynamics</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="site-header">
      <CompanyLogo />

      <nav aria-label="Main navigation">
        {
          links.map(([label, url]) => (
            <a
              href={url}
              aria-current={
                (page === "home" && url === "/") || url === "/" + page
                  ? "page"
                  : undefined
              }
            >
              {label}
            </a>
          ))
        }
      </nav>

      <a class="button dark" href="/contact">
        Get In Touch <span aria-hidden="true">→</span>
      </a>
    </header>

    <main id="main"><slot /></main>
  </body>
</html>
