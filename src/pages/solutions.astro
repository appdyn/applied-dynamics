---
import AppliedLayout from "../layouts/AppliedLayout.astro";
import ApprovedHero from "../components/ApprovedHero.astro";
import ServiceCard from "../components/ServiceCard.astro";
---
<AppliedLayout title="/solutions" page="solutions"><ApprovedHero page="solutions" title="Solutions for Real-World Impact" description="From strategy and implementation to ongoing support, we help you design, deploy, and scale secure AI and cloud solutions that deliver measurable value." width={341} height={146}/><section class="content grid two"><ServiceCard title="AI Deployment & Implementation" text="Assess, design and deploy AI solutions tailored to your organization." icon="grid" /><ServiceCard title="Agentic Workflows" text="Build intelligent agents and workflows to automate complex processes." icon="workflow" /><ServiceCard title="Business Process Automation" text="Streamline operations and reduce manual work with secure automation." icon="gear" /><ServiceCard title="AI Knowledge & RAG" text="Turn your data into actionable knowledge with secure, private RAG solutions." icon="document" /><ServiceCard title="Secure AI" text="Implement AI safely with governance, access controls, and risk management." icon="shield" /><ServiceCard title="Ongoing Support & Optimization" text="Monitor, improve, and scale your solutions as your needs evolve." icon="growth" /></section></AppliedLayout>
