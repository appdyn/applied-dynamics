---
import Layout from '../layouts/Layout.astro';import PageHero from '../components/PageHero.astro';import Icon from '../components/Icon.astro';
const items=[['shield','U.S. Military & Defense','Secure, resilient solutions supporting mission readiness, operational security, and modernization.'],['government','Federal Government','Cybersecurity, cloud modernization, and emerging technology support for federal missions.'],['government','State & Local Government','Practical technology solutions that improve security, service delivery, and organizational resilience.'],['building','Commercial & Growing Businesses','Practical AI, cybersecurity, automation, and cloud solutions designed especially for small and mid-size organizations.']];
---
<Layout title="Industries | Applied Dynamics"><PageHero eyebrow="Who We Serve" title="Industries We Serve" description="Deep technical experience across government and commercial organizations, with particular focus on mission-critical environments and growing businesses." image="/images/hero-industries.jpg"/><section class="section"><div class="container grid-2">{items.map(([icon,title,text])=><article class="card industry"><Icon name={icon}/><h2>{title}</h2><p>{text}</p><a href="/contact">Learn More →</a></article>)}</div></section></Layout>
<style>.industry{min-height:280px;padding:40px;color:#0878f9}.industry h2{margin-top:30px;color:#07182d;font-size:23px}.industry p{color:#5c6e82;line-height:1.7}.industry a{display:inline-block;margin-top:15px;color:#0878f9;text-decoration:none;font-weight:600}</style>
