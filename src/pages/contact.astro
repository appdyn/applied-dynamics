---
import Layout from '../layouts/Layout.astro';import PageHero from '../components/PageHero.astro';
---
<Layout title="Contact | Applied Dynamics"><PageHero eyebrow="Contact" title="Let's Build What's Next." description="Have a question or want to discuss a project? We'd love to hear from you." image="/images/hero-contact.jpg"/><section class="section"><div class="container contact"><div class="form"><h2>Send Us a Message</h2><form><label>Name<input type="text" name="name" placeholder="Your name"/></label><label>Email<input type="email" name="email" placeholder="you@company.com"/></label><label>Company<input type="text" name="company" placeholder="Your company"/></label><label>How can we help?<textarea name="message" rows="6" placeholder="Tell us about your needs..."></textarea></label><button type="submit" class="button button-primary">Send Message →</button></form></div><aside><h2>Contact Information</h2><div><strong>Email</strong><span>info@appliedynamics.com</span></div><div><strong>Location</strong><span>Northern Virginia<br/>Serving clients nationwide</span></div><hr/><h3>Let's Talk</h3><p>Whether you're exploring AI solutions, need cybersecurity expertise, or want to discuss a specific project, our team is ready to help.</p></aside></div></section></Layout>
<style>.contact{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(300px,.8fr);gap:70px}.form,aside{padding:34px;border:1px solid #e4eaf0;border-radius:10px}form{display:grid;gap:20px;margin-top:30px}label{display:grid;gap:8px;font-size:13px;font-weight:600}input,textarea{width:100%;padding:13px 14px;border:1px solid #dce4ec;border-radius:5px;outline:none}input:focus,textarea:focus{border-color:#1687ff;box-shadow:0 0 0 3px rgba(22,135,255,.08)}aside div{margin-top:28px}aside strong,aside span{display:block}aside span{margin-top:6px;color:#607388;line-height:1.6}aside hr{margin:35px 0;border:0;border-top:1px solid #e4eaf0}aside p{color:#607388;line-height:1.7}@media(max-width:800px){.contact{grid-template-columns:1fr}}</style>
