---
const {
  eyebrow = '',
  title,
  description,
  image = ''
} = Astro.props;
---

<section
  class="page-hero"
  style={image ? `--hero-image: url("${image}")` : ''}
>
  <div class="hero-overlay" aria-hidden="true"></div>

  <div class="container page-hero-content">
    {eyebrow && <div class="page-eyebrow">{eyebrow}</div>}
    <h1>{title}</h1>
    <p>{description}</p>
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    min-height: 330px;
    display: flex;
    align-items: center;
    overflow: hidden;
    color: white;
    background-color: #061522;
    background-image: var(--hero-image);
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgba(4, 17, 31, 0.98) 0%,
        rgba(4, 17, 31, 0.92) 32%,
        rgba(4, 17, 31, 0.72) 52%,
        rgba(4, 17, 31, 0.28) 74%,
        rgba(4, 17, 31, 0.08) 100%
      );
  }

  .page-hero-content {
    position: relative;
    z-index: 2;
    padding-top: 58px;
    padding-bottom: 58px;
  }

  .page-eyebrow {
    margin-bottom: 15px;
    color: #64b2ff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 760px;
    margin: 0;
    font-size: clamp(2.65rem, 4.7vw, 4.2rem);
    line-height: 1.01;
    letter-spacing: -0.05em;
  }

  p {
    max-width: 660px;
    margin-top: 20px;
    color: #d2dce6;
    font-size: 16px;
    line-height: 1.7;
  }

  @media (max-width: 700px) {
    .page-hero {
      min-height: 360px;
      background-position: 65% center;
    }

    .hero-overlay {
      background: rgba(4, 17, 31, 0.78);
    }
  }
</style>
