---
const {
  eyebrow = '',
  title,
  description,
  image = ''
} = Astro.props;
---

<section class="page-hero">
  {image && (
    <img
      class="hero-image"
      src={image}
      alt=""
      aria-hidden="true"
      loading="eager"
      fetchpriority="high"
    />
  )}

  <div class="hero-overlay" aria-hidden="true"></div>

  <div class="container page-hero-content">
    {eyebrow && <div class="page-eyebrow">{eyebrow}</div>}
    <h1>{title}</h1>
    <p>{description}</p>
  </div>
</section>

<style>
  .page-hero {
    min-height: 330px;
    position: relative;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: #061522;
    color: white;
  }

  .hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-overlay {
    position: absolute;
    z-index: 1;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgba(4,17,31,.97) 0%,
        rgba(4,17,31,.88) 29%,
        rgba(4,17,31,.54) 50%,
        rgba(4,17,31,.16) 75%,
        rgba(4,17,31,.03) 100%
      );
  }

  .page-hero-content {
    position: relative;
    z-index: 2;
    padding-block: 58px;
  }

  .page-eyebrow {
    margin-bottom: 15px;
    color: #64b2ff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .22em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 760px;
    margin: 0;
    font-size: clamp(2.65rem, 4.7vw, 4.2rem);
    line-height: 1.01;
    letter-spacing: -.05em;
  }

  p {
    max-width: 660px;
    margin: 20px 0 0;
    color: #d2dce6;
    font-size: 16px;
    line-height: 1.7;
  }

  @media (max-width: 700px) {
    .page-hero {
      min-height: 360px;
    }

    .hero-image {
      object-position: 67% center;
    }

    .hero-overlay {
      background: rgba(4,17,31,.74);
    }
  }
</style>
