---
import Logo from "./CompanyLogo.astro";
const currentPath = Astro.url.pathname;
const nav = [
  ["Home", "/"],
  ["Capabilities", "/capabilities"],
  ["Solutions", "/solutions"],
  ["Industries", "/industries"],
  ["Insights", "/insights"],
  ["About", "/about"],
  ["Careers", "/careers"],
];
const active = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<header class="site-header">
  <div class="container header-inner">
    <div class="header-brand">
        <Logo />
    </div>
        <nav class="desktop-nav" aria-label="Primary navigation">
      {
        nav.map(([label, href]) => (
          <a href={href} class:list={{ active: active(href) }}>
            {label}
          </a>
        ))
      }
    </nav><a href="/contact" class="contact-button"
      >Get In Touch <span>→</span></a
    ><button
      class="menu-button"
      aria-label="Open navigation"
      aria-expanded="false"><span></span><span></span><span></span></button>
  </div><nav class="mobile-nav" aria-label="Mobile navigation">
    {
      nav.map(([label, href]) => (
        <a href={href} class:list={{ active: active(href) }}>
          {label}
        </a>
      ))
    }<a href="/contact">Get In Touch →</a>
  </nav>
</header>
<script>
  const b = document.querySelector(".menu-button");
  const m = document.querySelector(".mobile-nav");
  b?.addEventListener("click", () => {
    const o = m?.classList.toggle("open") ?? false;
    b.setAttribute("aria-expanded", String(o));
  });
</script>
<style>
  .site-header {
    height: 88px;
    display: flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.94);
    border-bottom: 1px solid #edf1f5;
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(16px);
  }
  .header-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 34px;
  }
  .desktop-nav {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 29px;
  }
  .desktop-nav a {
    height: 100%;
    display: flex;
    align-items: center;
    position: relative;
    text-decoration: none;
    color: #21364d;
    font-size: 13px;
    font-weight: 550;
  }
  .desktop-nav a:after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 18px;
    height: 2px;
    background: #1687ff;
    transform: scaleX(0);
    transition: 0.16s;
  }
  .desktop-nav a:hover:after,
  .desktop-nav a.active:after {
    transform: scaleX(1);
  }
  .desktop-nav a.active {
    color: #0878f9;
  }
  .contact-button {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 46px;
    padding: 0 21px;
    border-radius: 8px;
    background: #07182d;
    color: #fff;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    box-shadow: 0 8px 22px rgba(7, 24, 45, 0.1);
  }
  .menu-button {
    display: none;
    width: 44px;
    height: 44px;
    border: 0;
    background: transparent;
    padding: 10px;
  }
  .menu-button span {
    display: block;
    height: 2px;
    background: #07182d;
    margin: 5px 0;
  }
  .mobile-nav {
    display: none;
    position: absolute;
    top: 88px;
    left: 0;
    right: 0;
    background: #fff;
    padding: 18px 24px 26px;
    border-bottom: 1px solid #e7edf3;
    box-shadow: 0 18px 30px rgba(7, 24, 45, 0.08);
  }
  .mobile-nav a {
    display: block;
    padding: 12px 0;
    text-decoration: none;
    color: #21364d;
    font-weight: 600;
  }
  .mobile-nav a.active {
    color: #0878f9;
  }
  @media (max-width: 980px) {
    .desktop-nav,
    .contact-button {
      display: none;
    }
    .menu-button {
      display: block;
    }
    .mobile-nav.open {
      display: block;
    }
  }
</style>
