---
const { name } = Astro.props;
---
<span class="icon" aria-hidden="true">
{name==='shield'&&<svg viewBox="0 0 24 24"><path d="M12 3l7 3v5c0 5-3.4 8.4-7 10-3.6-1.6-7-5-7-10V6l7-3z"/><path d="M9 12l2 2 4-5"/></svg>}
{name==='brain'&&<svg viewBox="0 0 24 24"><path d="M9 4a3 3 0 0 0-3 3 3 3 0 0 0-2 5 3 3 0 0 0 2 5 3 3 0 0 0 3 3M15 4a3 3 0 0 1 3 3 3 3 0 0 1 2 5 3 3 0 0 1-2 5 3 3 0 0 1-3 3M12 3v18M9 8h3M12 16h3"/></svg>}
{name==='gear'&&<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9L7 7M17 17l2.1 2.1M19.1 4.9L17 7M7 17l-2.1 2.1"/></svg>}
{name==='cloud'&&<svg viewBox="0 0 24 24"><path d="M7 18h11a4 4 0 0 0 .5-8A6.5 6.5 0 0 0 6 8.5 4.5 4.5 0 0 0 7 18z"/></svg>}
{name==='chart'&&<svg viewBox="0 0 24 24"><path d="M4 20V10M10 20V5M16 20v-8M22 20V2"/></svg>}
{name==='government'&&<svg viewBox="0 0 24 24"><path d="M3 9h18L12 3 3 9zM5 10v8M9 10v8M15 10v8M19 10v8M3 21h18"/></svg>}
{name==='building'&&<svg viewBox="0 0 24 24"><path d="M4 21V7l8-4 8 4v14M8 9v2M12 9v2M16 9v2M8 14v2M12 14v2M16 14v2M2 21h20"/></svg>}
{name==='users'&&<svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2"/><path d="M3 20c0-4 2.5-6 6-6s6 2 6 6M15 14c3 0 5 2 5 5"/></svg>}
</span>
<style>.icon{display:inline-flex}.icon svg{width:34px;height:34px;stroke:currentColor;stroke-width:1.7;fill:none;stroke-linecap:round;stroke-linejoin:round}</style>
