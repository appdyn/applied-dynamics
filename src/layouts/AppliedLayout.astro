---
import '../styles/applied-dynamics.css';
const { title, page } = Astro.props;
const links = [['Home','/'],['Capabilities','/capabilities'],['Solutions','/solutions'],['Industries','/industries'],['Insights','/insights'],['About','/about'],['Careers','/careers'],['Contact','/contact']];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title} | Applied Dynamics</title></head>
<body><a class="skip" href="#main">Skip to content</a><header class="site-header"><a href="/" aria-label="Applied Dynamics home"><img class="logo" src="/images/applied-dynamics-logo.webp" width="66" height="22" alt="Applied Dynamics"/></a><nav aria-label="Main navigation">{links.map(([label,url])=><a href={url} aria-current={(page === 'home' && url === '/') || url === '/' + page ? 'page' : undefined}>{label}</a>)}</nav><a class="button dark" href="/contact">Get In Touch <span aria-hidden="true">→</span></a></header><main id="main"><slot/></main></body></html>
