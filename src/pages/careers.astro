---
import Layout from '../layouts/Layout.astro';import PageHero from '../components/PageHero.astro';import Icon from '../components/Icon.astro';
const benefits=[['gear','Meaningful Work','Solve important real-world problems.'],['chart','Growth','Expand your skills and experience.'],['users','Flexible','Collaborative and flexible work environment.'],['brain','Impact','Help shape modern technology solutions.']];
const positions=['AI / ML Engineer','Cybersecurity Analyst','Cloud Solutions Architect','Technical Project Manager'];
---
<Layout title="Careers | Applied Dynamics"><PageHero eyebrow="Join Our Team" title="Build What Matters." description="Join engineers, problem solvers, and innovators applying technology to real-world challenges." image="/images/hero-careers.jpg"/><section class="section"><div class="container"><h2 class="section-title">Why Work at Applied Dynamics</h2><div class="benefits">{benefits.map(([icon,title,text])=><article><Icon name={icon}/><h3>{title}</h3><p>{text}</p></article>)}</div><div class="positions"><h2>Open Positions</h2>{positions.map(position=><article><div><strong>{position}</strong><span>Engineering · Remote / Hybrid</span></div><a href="/contact">View Details →</a></article>)}</div></div></section></Layout>
<style>.benefits{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;margin-top:45px}.benefits article{text-align:center;color:#0878f9}.benefits h3{color:#07182d}.benefits p{color:#64768a;font-size:14px}.positions{margin-top:85px}.positions article{min-height:82px;display:flex;align-items:center;justify-content:space-between;padding:0 24px;border-bottom:1px solid #e3e9ef}.positions strong,.positions span{display:block}.positions span{margin-top:5px;color:#74859a;font-size:12px}.positions a{color:#0878f9;text-decoration:none;font-size:13px;font-weight:600}@media(max-width:800px){.benefits{grid-template-columns:repeat(2,1fr)}}@media(max-width:520px){.benefits{grid-template-columns:1fr}}</style>
